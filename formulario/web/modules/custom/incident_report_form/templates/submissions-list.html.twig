{#
/**
 * @file
 * Template for displaying a list of a users incident report submissions.
 *
 * Available variables:
 * - submissions: information about the submission
 * - current_user: usuario actualmente logueado en el sitio
 */
#}
{% if no_connection %}
  <div class="messages messages--error" style="background: #f8d7da; color: #721c24; padding: 20px; margin: 20px 0; border: 1px solid #f5c6cb;">
    <strong>{{ 'Sin conexión'|t }}:</strong> {{ 'No se pudo establecer conexión con el servidor. Revisa tu conexión a internet.'|t }}
  </div>
{% else %}
  <div>
    <div>
      {% for sub in submissions %}
        {% if sub.user == current_user %}
          <div style="display: flex;">
              <h4>{{ sub.titulo }} | <span style="font-weight: lighter; font-style: italic;">{{ sub.created }}</span></h4>
          </div>
          <div>
            <p class="pokemon-card-id"><b>Descripcion:</b> {{ sub.descripcion }}</p>
            <p class="pokemon-card-id"><b>Prioridad:</b> {{ sub.prioridad }}
            </p>
          </div>
          <hr>
        {% else %}
          <div>
            <p>No hay solicitudes hasta el momento.</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}